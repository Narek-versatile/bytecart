// @name Stackfall
// @desc Falling-block puzzle. Swipe or D-pad left/right to move, tap or UP to rotate, hold DOWN to fall faster, A to drop. Clear several rows at once for big points.
// @medium qr
grid(10, 20)
// 7 pieces x 4 cells, stored as (x+1, y+1) around the rotation centre
data P = [0,1, 1,1, 2,1, 3,1,
          1,0, 2,0, 1,1, 2,1,
          0,1, 1,1, 2,1, 1,0,
          1,0, 2,0, 0,1, 1,1,
          0,0, 1,0, 1,1, 2,1,
          0,0, 0,1, 1,1, 2,1,
          2,0, 0,1, 1,1, 2,1]
data COL = [SKY, YELLOW, PURPLE, GREEN, RED, BLUE, ORANGE]
data PTS = [0, 1, 3, 5, 8]
var ax = 0, ay = 0, pt = 0, nx = 0, lines = 0, fall = 0, speed = 26, rep = 0

fn load(t) {
  for i in 0..8 { mem[i] = P[t * 8 + i] - 1 }
}
fn fits(ox, oy) {
  for i in 0..4 {
    if get(ax + ox + mem[i * 2], ay + oy + mem[i * 2 + 1]) != 0 { return 0 }
  }
  return 1
}
fn draw(t) {
  for i in 0..4 { set(ax + mem[i * 2], ay + mem[i * 2 + 1], t) }
}
fn turn() {
  for i in 0..4 {
    var x = mem[i * 2]
    mem[i * 2] = -mem[i * 2 + 1]
    mem[i * 2 + 1] = x
  }
}
fn rotate() {
  if pt == 1 { return }
  turn()
  if fits(0, 0) { sfx(7); return }
  if fits(1, 0) { ax++; return }
  if fits(-1, 0) { ax--; return }
  if fits(2, 0) { ax += 2; return }
  turn()
  turn()
  turn()
}
fn spawn() {
  pt = nx
  nx = rnd(7)
  load(pt)
  ax = 4
  ay = 1
  if !fits(0, 0) { draw(COL[pt]); over() }
}
fn lock() {
  draw(COL[pt])
  var n = 0
  for y in 0..20 {
    if rowfull(y) { delrow(y); n++ }
  }
  if n > 0 {
    lines += n
    score += PTS[n] * 100
    sfx(4)
    speed = max(3, 26 - lines / 4 * 2)
  } else { sfx(1) }
  spawn()
}
fn side(k, d) {
  if pressed(k) { rep = 0; if fits(d, 0) { ax += d } }
  else if held(k) {
    rep++
    if rep > 6 && rep % 2 == 0 && fits(d, 0) { ax += d }
  }
}

nx = rnd(7)
spawn()
loop {
  draw(0)
  side(LEFT, -1)
  side(RIGHT, 1)
  if pressed(UP) || pressed(B) || tapped() { rotate() }
  if pressed(A) {
    while fits(0, 1) { ay++; score += 2 }
    fall = 99
  }
  fall++
  if fall >= speed || (held(DOWN) || pressed(DOWN)) && fall >= 2 {
    fall = 0
    if fits(0, 1) { ay++ } else { lock() }
  }
  draw(COL[pt])
  frame()
}
